# What never enters the build context.
#
# Two reasons, and the second is the important one. Speed: node_modules and .git are most of the
# repository's bytes and neither is used by a build stage. Safety: the docs stage does `COPY . .`,
# so anything reachable here is one careless layer away from being in an image -- and `.env` and
# `factory.toml` hold live credentials.

# Version control
.git
.gitignore
.gitlab-ci.yml

# Secrets and local configuration. Never in an image, at any stage.
.env
.env.*
!.env.example
factory.toml
*.pem
*.key

# Durable state. A build that copied in a developer's database would ship their data.
var/
data/
*.db
*.db-wal
*.db-shm

# Build outputs, all regenerated by the build stages. Copying stale ones in risks a layer where
# the SPA is older than the source that supposedly produced it.
frontend/node_modules/
frontend/dist/
static/spa/
static/docs/
docs/_build/

# Python local state
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.json
htmlcov/

# CI and editor scratch
.pip-cache/
.npm-cache/
report*.xml
.idea/
.vscode/
.DS_Store

# Agent and IDE configuration. Instructions for tooling, not application inputs.
.cursor/
AGENTS.md
CLAUDE.md
