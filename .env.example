# NVIS Software Factory — deployment environment (EXAMPLE)
#
#   cp .env.example .env && $EDITOR .env
#
# Read by docker-compose. This file holds the settings a DEPLOYMENT must supply: the ones with no
# usable default, plus the secrets.
#
# WHY BOTH THIS AND factory.toml.example
#   factory.toml.example is the complete, generated catalogue of all 40 settings with their
#   defaults — the reference you read when you want to know what is tunable. This is the short
#   list you actually have to fill in, and it is the only one of the two that may hold secrets.
#   Environment wins over the TOML file, so anything set here overrides it.
#
# NEVER COMMIT THE FILLED-IN COPY. .env is gitignored and .dockerignore keeps it out of the build
# context, but neither of those helps if someone renames it.


# ── Where this deployment lives ──────────────────────────────────────────────────────────────

# REQUIRED. The externally reachable base URL, no trailing slash. The OIDC redirect URI is built
# from it, so it must match what is registered with the provider exactly — scheme included. A
# mismatch here is the single most common cause of a login that loops back to sign-in.
NVSF_PUBLIC_URL=https://factory.your-site.nvidia.com

# 0.0.0.0 to accept traffic from outside the container. The image defaults to loopback so that an
# unconfigured deployment is not reachable; change this only once TLS and OIDC below are real.
NVSF_BIND_ADDR=0.0.0.0
NVSF_PORT=8000

# Inside the container. The host side of the bind mount is set by NVSF_HOST_DATA_DIR below.
NVSF_DATA_DIR=/data

# Host path for the data bind mount. A host path, not a named volume: `docker volume prune`
# removes unused named volumes without asking what is in them. Create it and give it to the
# container's UID before first start:
#     sudo mkdir -p /srv/nvsf/data && sudo chown 10001:10001 /srv/nvsf/data
NVSF_HOST_DATA_DIR=/srv/nvsf/data


# ── TLS ──────────────────────────────────────────────────────────────────────────────────────
#
# Required in production. The session cookie is set Secure, and a Secure cookie sent over
# plaintext is silently discarded by the browser — which presents as "sign-in does nothing" with
# no error anywhere. The startup gate refuses to run without TLS rather than let you find that
# out interactively.
#
# Paths are inside the container; mount the real ones read-only in docker-compose.yml.

NVSF_TLS_CERT=/etc/nvsf/tls/fullchain.pem
NVSF_TLS_KEY=/etc/nvsf/tls/privkey.pem

# Host directory holding fullchain.pem and privkey.pem.
NVSF_HOST_TLS_DIR=/etc/nvsf/tls


# ── Identity ─────────────────────────────────────────────────────────────────────────────────
#
# OIDC is the only authentication method. There is no local account table, no bootstrap admin
# password, and no way to turn it off outside loopback development.

NVSF_OIDC_ISSUER=https://your-idp.nvidia.com/
NVSF_OIDC_CLIENT_ID=nvis-software-factory

# SECRET. Omit entirely for a public client using PKCE alone, which is preferred where the
# provider supports it.
NVSF_OIDC_CLIENT_SECRET=

# The 'groups' scope is what carries role membership. Without it every user signs in successfully
# and lands as a viewer, which looks like a permissions bug and is a scope problem.
NVSF_OIDC_SCOPES=openid profile email groups

# group=role pairs. Groups with no mapping get 'viewer'.
NVSF_OIDC_ROLE_MAP=nvis-ova=ova,nvis-aic=aic,nvis-ethernet=ethernet,nvis-ib=ib

# Empty means nobody is an admin, which is the right default for a fresh deployment. Grant it to a
# group you control, not a broad one.
NVSF_OIDC_ADMIN_GROUPS=

# SECRET, optional. Generated and persisted under the data directory on first start if unset, so
# a restart does not sign everyone out. Set it explicitly only when running more than one host.
NVSF_SESSION_SECRET=


# ── Reasoning endpoint ───────────────────────────────────────────────────────────────────────
#
# REQUIRED, all three. This application is AI-first in the literal sense: reasoning is a pipeline
# stage, not an enhancement, and there is no scanner-only fallback. The startup gate probes the
# endpoint and refuses to boot if it cannot reach it — a report that quietly answers a third of
# the question is worse than no report, because nothing on the page says so.

# Check this model still exists before deploying, and expect to change it roughly yearly. The
# hosted catalog retires models on published dates: as of writing, the whole Llama 3.3 family went
# end-of-life on 2026-08-26 and now answers HTTP 410. Current identifiers come from
#   curl -s https://integrate.api.nvidia.com/v1/models | python3 -m json.tool
NVSF_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
NVSF_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# SECRET.
NVSF_LLM_API_KEY=


# ── Source access ────────────────────────────────────────────────────────────────────────────
#
# SECRETS, both optional — needed only for private repositories. Read-only scope: the Factory
# clones and never pushes. On GitLab that is 'read_repository' and nothing else.

NVSF_GITLAB_TOKEN=
NVSF_GITHUB_TOKEN=


# ── Optional tuning ──────────────────────────────────────────────────────────────────────────
#
# Everything below has a working default. Uncomment only with a reason.
# See factory.toml.example, or docs/reference/configuration, for the full catalogue.

# Concurrent assessments. Bounded by the shared reasoning endpoint, not by local CPU.
# NVSF_ASSESSMENT_WORKERS=2

# Gunicorn workers. See the note in the registry before raising this: each one runs its own
# assessment pool and its own SQLite connections.
# NVSF_WEB_WORKERS=2

# Snapshot cadence and retention. 0 disables snapshots, which fails the app's own durability
# criterion D3 and is reported as such on the health page.
# NVSF_BACKUP_INTERVAL_HOURS=24
# NVSF_BACKUP_RETAIN_DAYS=14

# NVSF_LOG_LEVEL=INFO
# NVSF_LOG_JSON=false
