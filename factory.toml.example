# NVIS Software Factory — configuration (EXAMPLE)
#
# GENERATED by bin/gen-factory-example.py from backend/config_registry.py. Do not hand-edit: add or
# change the declaration and regenerate, or this file drifts from the code that reads it. CI runs
# `bin/gen-factory-example.py --check` and fails on a stale copy.
#
# HOW TO USE
#   cp factory.toml.example factory.toml
#   $EDITOR factory.toml
#
# Every value here can also be set as an environment variable — the name is shown above each entry.
# The ENVIRONMENT WINS: this file is a baseline, applied with setdefault semantics at launch, so a
# container can be configured by compose without the file needing to know.
#
# SECRETS ARE REFUSED FROM THIS FILE. Settings marked secret in the registry are rejected at
# startup if they appear here, and the process exits rather than warning. Config files get
# committed; that is the whole reason. Supply them as environment variables or through a mounted
# secret file. They are listed at the bottom for reference.
#
# Values shown are the DEFAULTS. Commented-out lines are settings with no default, which you must
# supply — the application will not start without the ones marked REQUIRED.


[assessment]

# Concurrent assessment runs. The binding constraint is the shared LLM endpoint, not local CPU:
# each run makes roughly a dozen completions, and other teams use the same endpoint. A queued
# run that starts in two minutes is fine; rate-limiting the endpoint for everyone is not.
# env: NVSF_ASSESSMENT_WORKERS
workers = 2

[clone]

# Shallow clone depth. History is not needed to assess the current state, and fetching it is
# the slowest part of acquisition.
# env: NVSF_CLONE_DEPTH
depth = 1

# Refuse a working tree larger than this. Guards the data volume against a repository with
# large binaries in it.
# env: NVSF_CLONE_MAX_MB
max_mb = 512

# Hard timeout on a clone. The subprocess is killed, not merely abandoned.
# env: NVSF_CLONE_TIMEOUT_SEC
timeout_sec = 300

[llm]

# OpenAI-compatible endpoint, e.g. an internal NIM deployment. The application refuses to start
# without it: reasoning is a required pipeline stage and there is deliberately no degraded
# mode.
# env: NVSF_LLM_BASE_URL  REQUIRED
# base_url =

# Ceiling on serialized evidence per reasoning pass. Above this the evidence is summarized by
# map-reduce rather than truncated, so nothing is silently dropped.
# env: NVSF_LLM_EVIDENCE_BUDGET_CHARS
evidence_budget_chars = 120000

# Upper bound on a single completion. The remediation pass is the tallest: it returns three
# buckets of steps, each with a rationale, the files involved and a verification, so a
# repository with many findings genuinely needs the room. At 4096 it was cut off mid-string and
# the run failed on unparseable JSON.
# env: NVSF_LLM_MAX_OUTPUT_TOKENS
max_output_tokens = 8192

# Bounded retries with exponential backoff, on transport errors and 429/5xx only.
# env: NVSF_LLM_MAX_RETRIES
max_retries = 3

# Model identifier passed to the endpoint. Recorded with every assessment, so changing it makes
# previous results reproducible rather than silently stale.
# env: NVSF_LLM_MODEL  REQUIRED
# model =

# Low by default: this is analysis, not prose generation. Recorded per call.
# env: NVSF_LLM_TEMPERATURE
temperature = 0.2

# Per-request timeout. Explicit because a reasoning call with no timeout can hang a worker for
# minutes (reliability criterion R1).
# env: NVSF_LLM_TIMEOUT_SEC
timeout_sec = 180

[logging]

# Emit structured JSON lines instead of human-readable text.
# env: NVSF_LOG_JSON
json = false

# Root log level.
# One of: DEBUG, INFO, WARNING, ERROR
# env: NVSF_LOG_LEVEL
level = "INFO"

# Comma-separated: stdout, file. 'file' writes under the data directory.
# env: NVSF_LOG_SINKS
sinks = "stdout"

[oidc]

# Comma-separated groups granted the admin role. Empty means nobody is an admin, which is the
# safe default for a fresh deployment.
# env: NVSF_OIDC_ADMIN_GROUPS
admin_groups = ""

# Client identifier registered with the provider.
# env: NVSF_OIDC_CLIENT_ID  REQUIRED
# client_id =

# ID token claim holding group membership.
# env: NVSF_OIDC_GROUPS_CLAIM
groups_claim = "groups"

# Issuer URL. Discovery is fetched from {issuer}/.well-known/openid-configuration.
# env: NVSF_OIDC_ISSUER  REQUIRED
# issuer =

# Local development only. Substitutes a fake provider that logs in a fixed user. Refused unless
# NVSF_ENV=development AND the bind address is loopback.
# Never set this in a deployment. The startup gate exits non-zero if it is on in production,
# rather than warning.
# env: NVSF_OIDC_MOCK
mock = false

# Comma-separated group=role pairs, e.g. 'nvis-ova=ova,nvis-aic=aic'. Groups with no mapping
# get the 'viewer' role.
# env: NVSF_OIDC_ROLE_MAP
role_map = ""

# Space-separated scopes. 'groups' is what carries role membership.
# env: NVSF_OIDC_SCOPES
scopes = "openid profile email groups"

# Session lifetime before re-authentication is required.
# env: NVSF_SESSION_TTL_HOURS
session_ttl_hours = 12

[retention]

# How often to snapshot the database with VACUUM INTO. 0 disables, which fails durability
# criterion D3 and is reported as such by the app's own self-check.
# env: NVSF_BACKUP_INTERVAL_HOURS
backup_interval_hours = 24

# How long snapshots are kept.
# env: NVSF_BACKUP_RETAIN_DAYS
backup_retain_days = 14

# How long a clone is kept after its assessment finishes. Cloned source is not durable state;
# it is kept briefly so a failed run can be retried without re-fetching.
# env: NVSF_WORKSPACE_RETAIN_HOURS
workspace_retain_hours = 6

[runtime]

# Address gunicorn binds. Defaults to loopback so a fresh deployment is not exposed before TLS
# and OIDC are configured.
# env: NVSF_BIND_ADDR
bind_addr = "127.0.0.1"

# Root of all durable state. Must be a bind mount in production: a named volume can be removed
# by 'docker volume prune'.
# env: NVSF_DATA_DIR
data_dir = "var"

# Deployment mode. 'development' unlocks the mock identity provider and relaxes the TLS
# requirement; it is refused on a non-loopback bind.
# One of: production, development
# env: NVSF_ENV
env = "production"

# Port gunicorn binds inside the container.
# env: NVSF_PORT
port = 8000

# Externally reachable base URL, e.g. https://factory.nvidia.com. Used to build the OIDC
# redirect URI, so it must match what is registered with the provider.
# No trailing slash.
# env: NVSF_PUBLIC_URL  REQUIRED
# public_url =

# PEM certificate. Required in production; the app refuses to serve OIDC session cookies over
# plaintext.
# env: NVSF_TLS_CERT
# tls_cert =

# PEM private key matching tls_cert.
# env: NVSF_TLS_KEY
# tls_key =

# Threads per worker. Enough that a slow contract-bundle response cannot make the health check
# time out.
# env: NVSF_WEB_THREADS
web_threads = 4

# Gunicorn worker timeout. Long because the mapping assistant makes a reasoning call inside a
# request; finite because an unbounded timeout turns one hung upstream call into a worker that
# never returns.
# env: NVSF_WEB_TIMEOUT_SEC
web_timeout_sec = 300

# Gunicorn worker processes. Deliberately not '2 * cpu + 1': each worker runs its own
# assessment pool and its own SQLite connections, so the count multiplies both load on the
# shared reasoning endpoint and write contention on one database file.
# Capped at the CPU count at startup.
# env: NVSF_WEB_WORKERS
web_workers = 2

# ────────────────────────────────────────────────────────────────────────────
# SECRETS — set these in the environment, NOT in this file.
# Listed here so the full configuration surface is discoverable in one place.
# ────────────────────────────────────────────────────────────────────────────
#
#   Read-only token for private GitHub repositories.
#   export NVSF_GITHUB_TOKEN=...
#
#   Read-only token for private GitLab repositories. Needs 'read_repository' and nothing else.
#   export NVSF_GITLAB_TOKEN=...
#
#   Bearer token for the endpoint. Environment or mounted secret file only.
#   export NVSF_LLM_API_KEY=...
#
#   Client secret. Omit for a public client using PKCE alone.
#   export NVSF_OIDC_CLIENT_SECRET=...
#
#   Signing key for the session cookie. Generated and persisted to the data directory on first
#   start if unset, so a restart does not log everyone out.
#   export NVSF_SESSION_SECRET=...
